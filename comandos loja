    std::vector<Cliente> clientes;
    std::vector<Venda> vendas;
    std::string arquivoDados;
    int proximoCodigoVenda;
    bool textoValido(const std::string& texto) const;
public:
    explicit Loja(const std::string& arquivo = "dados.txt");

    void carregarDados();
    void salvarDados() const;

    bool cadastrarPlanta(std::unique_ptr<Planta> planta);
    void listarPlantas() const;
    int pesquisar(std::string nome) const;
    std::vector<int> pesquisarTodos(std::string nome) const;
    bool atualizarPlanta(int codigo, const std::string& nome,
                          double preco, int quantidade);
    bool removerPlanta(int codigo);

    bool cadastrarCliente(const Cliente& cliente);
    void listarClientes() const;

    bool registrarVenda(const string& nomePlanta,
                    const string& nomeCliente,
                    int quantidade);
    void listarVendas() const;

    const std::vector<std::unique_ptr<Planta>>& getPlantas() const;
    const std::vector<Cliente>& getClientes() const;
    const std::vector<Venda>& getVendas() const;
};

bool Loja::textoValido(const std::string& texto) const {
    return !texto.empty();
}

// ==================== Loja.cpp ====================

namespace {
    std::vector<std::string> dividir(const std::string& linha) {
        std::vector<std::string> campos;
        std::stringstream ss(linha);
        std::string campo;
        while (std::getline(ss, campo, ';')) campos.push_back(campo);
        return campos;
    }

    std::string minusculo(std::string texto) {
        std::transform(texto.begin(), texto.end(), texto.begin(),
            [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
        return texto;
    }
}

Loja::Loja(const std::string& arquivo)
    : arquivoDados(arquivo), proximoCodigoVenda(1) {
    carregarDados();
}

void Loja::carregarDados() {
    plantas.clear();
    clientes.clear();
    vendas.clear();
    proximoCodigoVenda = 1;

    std::ifstream arquivo(arquivoDados);
    if (!arquivo.is_open()) return;

    std::string linha;

    while (std::getline(arquivo, linha)) {
        try {
            auto c = dividir(linha);
            if (c.empty()) continue;

            if (c[0] == "PROD_A" && c.size() == 6) {
                plantas.push_back(make_unique<PlantaFrutifera>(
                    stoi(c[1]), c[2], stod(c[3]),
                    stoi(c[4]), c[5]));
            }
            else if (c[0] == "PROD_B" && c.size() == 6) {
                plantas.push_back(make_unique<PlantaFloral>(
                    stoi(c[1]), c[2], stod(c[3]),
                    stoi(c[4]), c[5]));
            }
            else if (c[0] == "PROD_C" && c.size() == 6) {
                plantas.push_back(make_unique<PlantaMedicinal>(
                    stoi(c[1]), c[2], stod(c[3]),
                    stoi(c[4]), c[5]));
            }
            else if (c[0] == "CLIENTE" && c.size() == 4) {
                clientes.emplace_back(stoi(c[1]), c[2], c[3]);
            }
            else if (c[0] == "VENDA" && c.size() == 6) {
                int id = stoi(c[1]);

                vendas.emplace_back(
                    id, c[2], c[3], stoi(c[4]), stod(c[5]));

                if (id >= proximoCodigoVenda)
                    proximoCodigoVenda = id + 1;
            }
        }
        catch (const std::exception& e) {
            std::cerr << "Erro ao carregar dados: " << e.what() << "\n";
        }
    }
}

void Loja::salvarDados() const {
    std::ofstream arquivo(arquivoDados, std::ios::trunc);
    if (!arquivo.is_open()) {
        std::cerr << "Erro: nao foi possivel salvar " << arquivoDados << ".\n";
        return;
    }
    for (const auto& p : plantas) arquivo << p->serializar() << "\n";
    for (const auto& c : clientes) arquivo << c.serializar() << "\n";
    for (const auto& v : vendas) arquivo << v.serializar() << "\n";
}
bool Loja::cadastrarPlanta(std::unique_ptr<Planta> planta) {
    if (!planta || planta->getCodigo() <= 0 ||
        !textoValido(planta->getNome()) ||
        planta->getPreco() < 0 || planta->getQuantidade() < 0) return false;

    for (const auto& p : plantas)
        if (p->getCodigo() == planta->getCodigo()) return false;

     plantas.push_back(std::move(planta));
    salvarDados();
    return true;
}
void Loja::listarPlantas() const {
    if (plantas.empty()) {
        std::cout << "Nenhuma planta cadastrada.\n";
        return;
    }
    for (std::size_t i = 0; i < plantas.size(); ++i) {
        std::cout << "[" << i << "] ";
        plantas [i]->exibirDetalhes();
    }
}
int Loja::pesquisar(std::string nome) const {
    auto indices = pesquisarTodos(nome);
    return indices.empty() ? -1 : indices.front();
}

std::vector<int> Loja::pesquisarTodos(std::string nome) const {
    std::vector<int> indices;
    const std::string busca = minusculo(nome);

    for (std::size_t i = 0; i < plantas.size(); ++i) {
        const std::string nomePlanta = minusculo(plantas[i]->getNome());
        if (nomePlanta.find(busca) == 0)
            indices.push_back(static_cast<int>(i));
    }
    return indices;
}

bool Loja::atualizarPlanta(int codigo, const std::string& nome,
                            double preco, int quantidade) {
    if (!textoValido(nome) || preco < 0 || quantidade < 0) return false;

    for (auto& p : plantas) {
        if (p->getCodigo() == codigo) {
            p->setNome(nome);
            p->setPreco(preco);
            p->setQuantidade(quantidade);
            salvarDados();
            return true;
        }
    }
    return false;
}

bool Loja::removerPlanta(int codigo) {
    auto it = std::find_if(plantas.begin(), plantas.end(),
        [codigo](const std::unique_ptr<Planta>& p) {
            return p->getCodigo() == codigo;
        });
    if (it == plantas.end()) return false;
    plantas.erase(it);
    salvarDados();
    return true;
}

bool Loja::cadastrarCliente(const Cliente& cliente) {
    if (cliente.getCodigo() <= 0 || !textoValido(cliente.getNome()) ||
        !textoValido(cliente.getContato())) return false;

    for (const auto& c : clientes)
        if (c.getCodigo() == cliente.getCodigo()) return false;

     clientes.push_back(cliente);
    salvarDados();
    return true;
}

void Loja::listarClientes() const {
    if (clientes.empty()) {
        std::cout << "Nenhum cliente cadastrado.\n";
        return;
    }
    for (const auto& c : clientes) c.exibir();
}

bool Loja::registrarVenda(const string& nomePlanta,
                          const string& nomeCliente,
                          int quantidade) {
    if (quantidade <= 0) return false;
    Planta* plantaEncontrada = nullptr;
    Cliente* clienteEncontrado = nullptr;

    for (const auto& p : plantas) {
        if (minusculo(p->getNome()) == minusculo(nomePlanta)) {
            plantaEncontrada = p.get();
            break;
        }
    }
    for (auto& c : clientes) {
        if (minusculo(c.getNome()) == minusculo(nomeCliente)) {
            clienteEncontrado = &c;
            break;
        }
    }
    if (plantaEncontrada == nullptr ||
        clienteEncontrado == nullptr) {
        return false;
    }
    if (plantaEncontrada->getQuantidade() < quantidade)
        return false;
    double total = plantaEncontrada->getPreco() * quantidade;
    plantaEncontrada->setQuantidade(
        plantaEncontrada->getQuantidade() - quantidade
    );
    vendas.emplace_back(
        proximoCodigoVenda++,
        plantaEncontrada->getNome(),
        clienteEncontrado->getNome(),
        quantidade,
        total
    );
    salvarDados();
    return true;
}

void Loja::listarVendas() const {
    if (vendas.empty()) {
        std::cout << "Nenhuma venda registrada.\n";
        return;
    }
    for (const auto& v : vendas) v.exibir();
}

const std::vector<std::unique_ptr<Planta>>& Loja::getPlantas() const {
    return plantas;
}
const std::vector<Cliente>& Loja::getClientes() const { return clientes; }
const std::vector<Venda>& Loja::getVendas() const { return vendas; }


// ==================== Relatorio.h ====================

class Relatorio {
public:
    static void estoque(const Loja& loja);
    static void clientes(const Loja& loja);
    static void vendas(const Loja& loja);
};


// ==================== Relatorio.cpp ====================

void Relatorio::estoque(const Loja& loja) {
    int totalUnidades = 0;
    double valorEstoque = 0.0;

    for (const auto& p : loja.getPlantas()) {
        totalUnidades += p->getQuantidade();
        valorEstoque += p->getPreco() * p->getQuantidade();
    }

    std::cout << "\n~~~~ RELATORIO DE ESTOQUE ~~~~\n"
              << "Tipos de produtos cadastrados: "
              << loja.getPlantas().size() << "\n"
              << "Unidades em estoque: " << totalUnidades << "\n"
              << "Valor total do estoque: R$ "
              << std::fixed << std::setprecision(2) << valorEstoque << "\n";
}

void Relatorio::clientes(const Loja& loja) {
    std::cout << "\n~~~~ RELATORIO DE CLIENTES ~~~~\n"
              << "Total de clientes: " << loja.getClientes().size() << "\n";
    loja.listarClientes();
}

void Relatorio::vendas(const Loja& loja) {
    double faturamento = 0.0;
    int unidadesVendidas = 0;

    for (const auto& v : loja.getVendas()) {
        faturamento += v.getValorTotal();
        unidadesVendidas += v.getQuantidade();
    }

    std::cout << "\n~~~~ RELATORIO DE VENDAS ~~~~\n"
              << "Quantidade de vendas: " << loja.getVendas().size() << "\n"
              << "Unidades vendidas: " << unidadesVendidas << "\n"
              << "Faturamento registrado: R$ "
              << std::fixed << std::setprecision(2) << faturamento << "\n";
    loja.listarVendas();
}


